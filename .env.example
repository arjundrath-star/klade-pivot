# Copy to .env.local. Never commit .env files.

# Anthropic. Coach and explain-back grading use Haiku 4.5; the weekly digest uses Sonnet 5.5.
ANTHROPIC_API_KEY=

# Database (libSQL). Local file in dev and CI; a hosted libSQL/Turso URL plus auth token in prod.
DATABASE_URL=file:./data/dev.db
DATABASE_AUTH_TOKEN=

# Public base URL of the deployed app (used in alert email previews).
NEXT_PUBLIC_APP_URL=http://localhost:3000
